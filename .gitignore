# 本地 Python 环境可以重新创建，不上传其安装包。
.venv/
venv/

# 原始数据、下载缓存和实验生成结果保留在本地。
data/
outputs/
checkpoints/
wandb/
runs/
.cache/

# 排除 Python 和开发工具生成的缓存。
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 排除访问令牌、环境变量与私钥；公开的示例配置可单独保留。
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.txt

# 排除本机编辑器设置和助手的私有或临时状态。
.vscode/
.idea/
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory-local/
.codex/

# 排除大型权重与本机日志；重要实验结果用文字记录在项目记忆中。
*.pt
*.pth
*.safetensors
*.onnx
*.log

# 排除操作系统生成的文件。
Thumbs.db
Desktop.ini
.DS_Store
